{
  "rules": {
    "arks_war_room": {
      ".read": true,
      "version_control": {
        ".read": true,
        ".write": "!data.exists() || auth != null"
      },
      "operatives": {
        "$character_name": {
          ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha' && (!newData.hasChildren(['meseta']) || newData.child('meseta').val() == 0 || !root.child('arks_war_room/version_control/min_secure_version').exists() || newData.child('client_version').val() >= root.child('arks_war_room/version_control/min_secure_version').val())"
        }
      },
      "sectors": {
        "$coord_key": {
          ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha'",
          "challengers": {
            "$character_name": {
              ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha' && (!newData.hasChildren(['meseta']) || newData.child('meseta').val() == 0 || !root.child('arks_war_room/version_control/min_secure_version').exists() || newData.child('client_version').val() >= root.child('arks_war_room/version_control/min_secure_version').val())"
            }
          },
          "sub_cells": {
            "$slot": {
              "challengers": {
                "$character_name": {
                  ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha' && (!newData.hasChildren(['meseta']) || newData.child('meseta').val() == 0 || !root.child('arks_war_room/version_control/min_secure_version').exists() || newData.child('client_version').val() >= root.child('arks_war_room/version_control/min_secure_version').val())"
                }
              }
            }
          }
        }
      },
      "latest_telemetry": {
        ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha'"
      },
      "war_logs": {
        ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha'",
        "$log_id": {
          ".write": "newData.hasChildren(['client_version']) && newData.child('client_version').val() != '7.0.0-alpha'"
        }
      }
    }
  }
}
