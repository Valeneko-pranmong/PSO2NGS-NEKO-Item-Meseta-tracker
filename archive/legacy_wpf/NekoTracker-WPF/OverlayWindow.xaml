<Window x:Class="NekoTracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:NekoTracker.Localization"
        mc:Ignorable="d"
        Title="NEKO Gadget Overlay"
        Width="300" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="{StaticResource DefaultFontFamily}"
        MouseDown="Window_MouseDown">

    <Border Background="{StaticResource BrushBgMain}"
            BorderBrush="{StaticResource BrushPinkHeader}"
            BorderThickness="2"
            CornerRadius="12"
            Opacity="0.95"
            x:Name="RootBorder"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#50FFC0CB" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Main Rate Display -->
                <RowDefinition Height="Auto"/> <!-- Wallet & Duration -->
                <RowDefinition Height="Auto"/> <!-- Security Badge -->
                <RowDefinition Height="*"/>    <!-- Item Drops List -->
                <RowDefinition Height="32"/> <!-- Footer Controls -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushPinkHeader}" CornerRadius="10,10,0,0">
                <Grid Margin="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌸" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="NEKO Gadget" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextMain}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushPinkAccent}" CornerRadius="6" Margin="6,0,0,0" Padding="4,1">
                            <TextBlock x:Name="TxtVersionBadge" Text="v7 Alpha" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnOpacity" Content="👁️" Width="24" Height="24" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnOpacity_Click" ToolTip="Toggle Opacity"/>
                        <Button x:Name="BtnReturnMain" Content="🗔" Width="24" Height="24" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnReturnMain_Click" ToolTip="Return to Main Window"/>
                        <Button x:Name="BtnClose" Content="✕" Width="24" Height="24"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Rate Display (Meseta / Hour) -->
            <Border Grid.Row="1" Background="{StaticResource BrushPinkSoft}" Margin="8,8,8,4" CornerRadius="8" Padding="8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtRateHeader" Text="MESETA / HOUR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMesetaRate" Text="0 /hr" FontFamily="{StaticResource NumberFontFamily}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextVal}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Income & Time -->
            <Grid Grid.Row="2" Margin="8,2,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrushPinkSoft}" CornerRadius="6" Padding="6" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="INCOME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}"/>
                        <TextBlock x:Name="TxtSessionMeseta" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextVal}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource BrushPinkSoft}" CornerRadius="6" Padding="6" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}"/>
                        <TextBlock x:Name="TxtDuration" Text="00:00:00" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Anti-Tamper Security Badge -->
            <Border Grid.Row="3" Margin="8,2,8,4" CornerRadius="6" Padding="4" x:Name="SecurityBorder" Background="#E8F5E9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtSecurityIcon" Text="🛡️" FontSize="10" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtSecurityText" Text="Security: Verified &amp; Safe" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGreenSafe}"/>
                </StackPanel>
            </Border>

            <!-- 5. Drop Items List -->
            <Border Grid.Row="4" Margin="8,2,8,4" Background="{StaticResource BrushPinkSoft}" CornerRadius="6" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource BrushTextMain}" TextTrimming="CharacterEllipsis" Width="200" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Count, StringFormat='x{0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushPinkAccent}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 6. Footer Controls -->
            <Border Grid.Row="5" Margin="8,0,8,4">
                <Grid>
                    <TextBlock x:Name="TxtCharacterInfo" Text="Operator: Ready" FontSize="9" Foreground="{StaticResource BrushTextSub}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClickThrough" Content="🎯 Click-Thru" HorizontalAlignment="Right" FontSize="9" Padding="6,2"
                            Background="{StaticResource BrushPinkHeader}" BorderThickness="0" Cursor="Hand" Click="BtnClickThrough_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
