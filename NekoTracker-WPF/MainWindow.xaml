<Window x:Class="NekoTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:NekoTracker.Localization"
        mc:Ignorable="d"
        Title="NEKO Item &amp; Meseta Tracker"
        Height="650" Width="980"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource DefaultFontFamily}"
        MouseDown="Window_MouseDown">

    <Border Background="{StaticResource BrushBgMain}"
            BorderBrush="{StaticResource BrushPinkHeader}"
            BorderThickness="2"
            CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#40FF69B4" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Top Action & Folder Bar -->
                <RowDefinition Height="Auto"/> <!-- Key Stats 4 Cards -->
                <RowDefinition Height="Auto"/> <!-- Operative & Security Bar -->
                <RowDefinition Height="*"/>    <!-- Drops List & Watchlist -->
                <RowDefinition Height="34"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushPinkHeader}" CornerRadius="12,12,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌸" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAppTitle" Text="NEKO Item &amp; Meseta Tracker" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextMain}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushPinkAccent}" CornerRadius="6" Margin="8,0,0,0" Padding="6,2">
                            <TextBlock x:Name="TxtVersionTag" Text="V7.0.0 Alpha" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Language Switchers -->
                        <Border Background="White" CornerRadius="6" Margin="0,0,12,0" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnLangEn" Content="EN" Width="28" Height="22" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnLang_Click"/>
                                <Button x:Name="BtnLangTh" Content="TH" Width="28" Height="22" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnLang_Click"/>
                                <Button x:Name="BtnLangJa" Content="JA" Width="28" Height="22" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnLang_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnMinimize" Content="━" Width="30" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click" FontWeight="Bold" FontSize="10"/>
                        <Button x:Name="BtnClose" Content="✕" Width="30" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Action & Folder Bar -->
            <Border Grid.Row="1" Background="{StaticResource BrushPinkSoft}" Margin="12,10,12,6" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSelectFolder" Grid.Column="0" Content="📂 Select Log Folder"
                            Background="{StaticResource BrushPinkHeader}" Foreground="{StaticResource BrushTextMain}"
                            FontWeight="Bold" FontSize="12" Padding="14,6" BorderThickness="0" Cursor="Hand" Click="BtnSelectFolder_Click"/>

                    <TextBlock x:Name="TxtLogFolderStatus" Grid.Column="1" Text="Waiting for Log..."
                               Foreground="{StaticResource BrushTextSub}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnOverlay" Content="📱 Gadget Overlay"
                                Background="{StaticResource BrushPinkAccent}" Foreground="White"
                                FontWeight="Bold" FontSize="12" Padding="14,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" Click="BtnOverlay_Click"/>
                        <Button x:Name="BtnReset" Content="🔄 Reset"
                                Background="{StaticResource BrushPinkHeader}" Foreground="{StaticResource BrushTextMain}"
                                FontWeight="SemiBold" FontSize="12" Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnReset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Key Stats Cards (4 Columns) -->
            <Grid Grid.Row="2" Margin="12,4,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Session Income -->
                <Border Grid.Column="0" Background="{StaticResource BrushPinkSoft}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock x:Name="LblIncome" Text="SESSION INCOME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}"/>
                        <TextBlock x:Name="TxtIncomeVal" Text="0" FontFamily="{StaticResource NumberFontFamily}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextVal}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Meseta / hr -->
                <Border Grid.Column="1" Background="{StaticResource BrushPinkSoft}" CornerRadius="10" Padding="12" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock x:Name="LblRate" Text="MESETA / HOUR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}"/>
                        <TextBlock x:Name="TxtRateVal" Text="0 /hr" FontFamily="{StaticResource NumberFontFamily}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushPinkAccent}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Current Wallet -->
                <Border Grid.Column="2" Background="{StaticResource BrushPinkSoft}" CornerRadius="10" Padding="12" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock x:Name="LblWallet" Text="CURRENT WALLET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}"/>
                        <TextBlock x:Name="TxtWalletVal" Text="0" FontFamily="{StaticResource NumberFontFamily}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Farming Time -->
                <Border Grid.Column="3" Background="{StaticResource BrushPinkSoft}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LblDuration" Text="FARMING TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSub}"/>
                        <TextBlock x:Name="TxtDurationVal" Text="00:00:00" FontFamily="{StaticResource NumberFontFamily}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Operative & Anti-Tamper Security Bar -->
            <Border Grid.Row="3" Margin="12,2,12,6" Background="{StaticResource BrushPinkSoft}" CornerRadius="8" Padding="10,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtCharacterInfo" Text="Operative: Ready" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextMain}"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" x:Name="MainSecurityBorder" Background="#E8F5E9" CornerRadius="6" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtMainSecurityIcon" Text="🛡️" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtMainSecurityText" Text="Security: Verified &amp; Safe" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGreenSafe}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. Drop Items List & Search -->
            <Border Grid.Row="4" Margin="12,4,12,6" Background="{StaticResource BrushPinkSoft}" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblTotalDrops" Text="Item Drops" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextMain}" Margin="0,0,12,0"/>
                            <CheckBox x:Name="ChkWatchlistOnly" Content="Watchlist Only" VerticalAlignment="Center" FontSize="11" Checked="ChkWatchlistOnly_Changed" Unchecked="ChkWatchlistOnly_Changed"/>
                        </StackPanel>

                        <TextBox x:Name="TxtSearchBox" HorizontalAlignment="Right" Width="200" Height="26"
                                 Padding="6,2" VerticalContentAlignment="Center" FontSize="11"
                                 TextChanged="TxtSearchBox_TextChanged"/>
                    </Grid>

                    <ListView Grid.Row="1" x:Name="LstDrops" Background="White" BorderThickness="1" BorderBrush="{StaticResource BrushPinkHeader}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Item Name" Width="680" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Count" Width="180" DisplayMemberBinding="{Binding Count}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- 6. Footer -->
            <Border Grid.Row="5" Margin="12,0,12,4">
                <Grid>
                    <TextBlock Text="🌸 NEKO FAMILY TEAM SHIP 4 JP • 100% Offline TOS Safe" FontSize="10" Foreground="{StaticResource BrushTextSub}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFooterVersion" Text="V7.0.0 Alpha" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource BrushTextSub}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
